    "min_learning_rate": 0.0001,
    "warmup_steps": 20,
    "weight_decay": 0.0,
    "grad_clip": 1.0,
    "eval_interval": 25,
    "eval_batches": 5,
    "checkpoint_interval": 100,
    "out_dir": "runs/overfit_chat",
    "validation_split": 0.0,
    "mixed_precision": false,
    "compile_model": false
  }
}
